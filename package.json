{
  "name": "turkce-slug",
  "version": "0.1.0",
  "description": "Turkish-aware slugify and text transformation utilities.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "demo": "npm run build && node demo/server.mjs",
    "corpus:build": "node scripts/build-corpus.mjs",
    "corpus:validate": "npm run build && node scripts/validate-corpus.mjs",
    "corpus": "npm run build && node scripts/build-corpus.mjs && node scripts/validate-corpus.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "turkish",
    "turkce",
    "slug",
    "slugify",
    "case",
    "i18n"
  ],
  "author": "Officalbluehair",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
